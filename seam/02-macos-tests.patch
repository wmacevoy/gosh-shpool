+/// Find a shell by name, on $PATH and then in the places systems put
+/// them (zsh is /bin/zsh on macOS, fish is wherever homebrew put it), so
+/// that tests don't depend on one system's layout.
+pub fn find_shell(name: &str) -> anyhow::Result<PathBuf> {
+    let path = env::var_os("PATH").unwrap_or_default();
+    env::split_paths(&path)
+        .chain(["/bin", "/usr/bin", "/usr/local/bin", "/opt/homebrew/bin"].map(PathBuf::from))
+        .map(|dir| dir.join(name))
+        .find(|candidate| candidate.is_file())
+        .ok_or(anyhow!("{name} not found: install it to run this test"))
+}
+
+/// Fill in a config template from the testdata directory whose `shell` is
+/// the placeholder "SHELL" with the path to the named shell, write it into
+/// `dir`, and return its path.
+pub fn shell_config(dir: &tmpdir::Dir, template: &str, shell: &str) -> anyhow::Result<PathBuf> {
+    let tmpl = std::fs::read_to_string(testdata_file(template))
+        .with_context(|| format!("reading {template}"))?;
+    let shell = find_shell(shell)?;
+    let config = dir.path().join(template.trim_end_matches(".tmpl"));
+    std::fs::write(
+        &config,
+        tmpl.replace("\"SHELL\"", &format!("{:?}", shell.display().to_string())),
+    )
+    .context("writing config")?;
+    Ok(config)
+}
+
